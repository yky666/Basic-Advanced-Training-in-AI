      Unreliable: false
      User: 255; 0; 0
      Value: true
      Virtual: 255; 0; 255
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
