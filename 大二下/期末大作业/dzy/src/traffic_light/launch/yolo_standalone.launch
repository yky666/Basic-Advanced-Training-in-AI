<launch>
  <arg name="traffic_light_dir" default="/home/agilex/agilex_ws/src/dzy/src/traffic_light" />
  <arg name="image_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="weights" default="$(arg traffic_light_dir)/weights/best.pt" />
  <arg name="debug_image" default="true" />
  <arg name="show_window" default="false" />
  <arg name="hold_seconds" default="3.0" />
  <arg name="prefer_lane" default="left" />
  <arg name="conf_threshold" default="0.35" />
  <arg name="iou_threshold" default="0.45" />
  <arg name="imgsz" default="640" />
  <arg name="device" default="" />
  <arg name="left_right_split" default="0.5" />
<node pkg="dzy" type="yolo_traffic_light_node.py" name="traffic_light_node" output="screen"
    launch-prefix="python3" 
    args="
      _image_topic:=$(arg image_topic)
      _depth_topic:=$(arg depth_topic)
      _weights_path:=$(arg weights)
      _publishing_debug_image:=$(arg debug_image)
      _show_window:=$(arg show_window)
      _hold_seconds:=$(arg hold_seconds)
      _prefer_lane:=$(arg prefer_lane)
      _conf_threshold:=$(arg conf_threshold)
      _iou_threshold:=$(arg iou_threshold)
      _imgsz:=$(arg imgsz)
      _device:=$(arg device)
      _left_right_split:=$(arg left_right_split)
    "
  />
</launch>