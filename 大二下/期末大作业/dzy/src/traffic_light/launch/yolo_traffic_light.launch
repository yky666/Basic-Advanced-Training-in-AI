<launch>
  <arg name="image_topic" default="/camera/color/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="weights" default="$(find traffic_light)/weights/best.pt" />
  <arg name="debug_image" default="true" />
  <arg name="show_window" default="false" />
  <arg name="hold_seconds" default="3.0" />
  <arg name="prefer_lane" default="left" />
  <arg name="conf_threshold" default="0.35" />
  <arg name="iou_threshold" default="0.45" />
  <arg name="imgsz" default="640" />
  <arg name="device" default="" />
  <arg name="left_right_split" default="0.5" />

  <node pkg="traffic_light" type="yolo_traffic_light_node.py" name="traffic_light_node" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="weights_path" value="$(arg weights)" />
    <param name="publish_debug_image" value="$(arg debug_image)" />
    <param name="show_window" value="$(arg show_window)" />
    <param name="hold_seconds" value="$(arg hold_seconds)" />
    <param name="prefer_lane" value="$(arg prefer_lane)" />
    <param name="conf_threshold" value="$(arg conf_threshold)" />
    <param name="iou_threshold" value="$(arg iou_threshold)" />
    <param name="imgsz" value="$(arg imgsz)" />
    <param name="device" value="$(arg device)" />
    <param name="left_right_split" value="$(arg left_right_split)" />
  </node>
</launch>
